{
  "name": "@moneytracker/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:test:setup": "tsx src/test-setup.ts",
    "db:set-password": "tsx src/set-password.ts",
    "db:disable-2fa": "tsx src/disable-two-factor.ts",
    "db:sync": "tsx src/sync-connections.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx src/reset.ts",
    "db:backup": "tsx src/backup-cli.ts create",
    "db:restore": "tsx src/backup-cli.ts restore",
    "db:backups": "tsx src/backup-cli.ts list"
  },
  "dependencies": {
    "@moneytracker/adapters": "workspace:*",
    "@moneytracker/core": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11"
  }
}
