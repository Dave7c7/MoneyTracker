# ---------------------------------------------------------------------------
# MoneyTracker environment configuration
#
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Every variable below is validated at startup with Zod; the app fails fast
# with a clear message when something is missing or malformed.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Postgres connection string.
# Docker Compose (default): postgresql://moneytracker:moneytracker@db:5432/moneytracker
# Local Postgres:           postgresql://moneytracker:moneytracker@localhost:5432/moneytracker
DATABASE_URL=postgresql://moneytracker:moneytracker@localhost:5432/moneytracker

# --- App ------------------------------------------------------------------
# IANA timezone used for monthly buckets and "today" boundaries.
# Monthly dashboards roll over at midnight in this timezone.
APP_TIMEZONE=America/Los_Angeles

# Currency used for display when an account currency is missing.
DEFAULT_CURRENCY=USD

# Locale used for number and currency formatting.
DEFAULT_LOCALE=en-US

# --- Docker Compose --------------------------------------------------------
# The address the app is published on the host. 127.0.0.1 keeps it on this
# machine; 0.0.0.0 lets a phone on the same network reach it. The app itself
# never reads this value.
BIND_ADDRESS=127.0.0.1

# --- Data source ----------------------------------------------------------
# Which adapter to use: "mock" (built-in demo data) or another registered id.
# Adding a new source must not require changing any other file.
ADAPTER_ID=mock

# --- Review inbox ---------------------------------------------------------
# Assignments below this confidence go to the review inbox. Bank-provided
# categories are capped at 0.7, so the default of 0.8 sends them to review
# as well. Lower it to 0.65 to trust the bank's categories.
REVIEW_CONFIDENCE_THRESHOLD=0.8

# --- Security -------------------------------------------------------------
# 32-byte key (hex or base64) for AES-256-GCM encryption of stored credentials.
# Required once a live bank connection is configured, and to turn on two-factor
# sign-in (the authenticator secret is encrypted with it). Generate with:
#   openssl rand -hex 32
# Never commit this value.
ENCRYPTION_KEY=

# --- AI categorizer (optional, off by default) ----------------------------
# The optional AI categorizer sends only cleaned merchant, description and an
# amount bucket. It never receives account numbers, balances or personal names.
AI_CATEGORIZER_ENABLED=false
AI_CATEGORIZER_PROVIDER=openai-compatible
AI_CATEGORIZER_BASE_URL=
AI_CATEGORIZER_API_KEY=
AI_CATEGORIZER_MODEL=
