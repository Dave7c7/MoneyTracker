{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@moneytracker/core": ["./packages/core/src/index.ts"],
      "@moneytracker/adapters": ["./packages/adapters/src/index.ts"],
      "@moneytracker/db": ["./packages/db/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "packages/*/*.config.ts"],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
